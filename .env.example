##############################################
# API Keys
##############################################
# Chave da API do The Movie Database (TMDB)
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

##############################################
# Servidor
##############################################
# Porta em que o servidor backend irá rodar
PORT=3000

##############################################
# Banco de Dados
##############################################
# String de conexão com o banco de dados PostgreSQL
# Exemplo: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/moviesdb?schema=public"

##############################################
# Autenticação JWT
##############################################
# Chave secreta usada para assinar tokens JWT
JWT_SECRET=YOUR_SECRET_KEY_HERE

# Tempo de expiração do token principal (ex: 1d, 12h, 30m)
JWT_EXPIRATION=1d

# Audiência e emissor dos tokens JWT
JWT_TOKEN_AUDIENCE=http://localhost:3000
JWT_TOKEN_ISSUER=http://localhost:3000

# Tempo de vida do token principal e do refresh (em segundos)
JWT_TTL=3600
JWT_REFRESH_TTL=86400

##############################################
# Domínios permitidos (CORS)
##############################################
# Domínio local (frontend)
ORIGIN_DOMAIN=http://localhost:5173

# Domínio de produção (ex: Vercel)
VERCEL_DOMAIN=https://the-movies.vercel.app
